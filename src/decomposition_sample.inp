clear
set verbose off

string DATADIR = "/home/admin-tarassow/git/forecasting_principles/data/gdt"

open "@DATADIR/aus_production.gdt" --preserve

#include stl.inp
include decomposition.inp
series y = Electricity

# Classical decomposition
scalar MULTIPLICATIVE = FALSE

bundle opts = defbundle("multiplicative", MULTIPLICATIVE)
bundle Model = clc_decompose(y, opts)

series trend = Model.trend
series season = Model.season
series remainder = Model.remainder
list L = trend season remainder
L += y

print L --head=10
print L --tail=10
scatters L --output=display

# Classical decomposition with trend extrapolation: fills in the NAs
# that trend_component()'s moving average otherwise leaves at both
# ends of the series (compare against the trend/remainder columns
# above, which have NAs at the head/tail). extrapolate_trend is the
# number of extra points (beyond the minimum of 1) used in the OLS fit
# at each edge -- a wider window gives a smoother, less noise-sensitive
# extrapolation.
bundle opts_ext = defbundle("multiplicative", MULTIPLICATIVE, "extrapolate_trend", 3)
bundle ModelExt = clc_decompose(y, opts_ext)

series trend_ext = ModelExt.trend
series season_ext = ModelExt.season
series remainder_ext = ModelExt.remainder
list Lext = trend_ext season_ext remainder_ext
Lext += y

print Lext --head=10
print Lext --tail=10
scatters Lext --output=display

stop


# STL decomposition
list L = empty
scalar ROBUST = TRUE

if ROBUST
    list L = stl_decompose(y, 13, 0, 0, 0, 0, ROBUST)
else
    list L = stl_decompose(y, 13)
endif
L += y
scatters L --output=display



