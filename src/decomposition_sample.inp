clear
set verbose off
include decomposition.gfn

# Monthly airline passengers (Box-Jenkins series G)
open bjg.gdt --quiet
series y = g


EXAMPLE = 1  # 1: Additive classical decomposition
            # 2: Multiplicative classical decomp. with trend extrapolation
            # 3: STL decomposition with robust weights


if EXAMPLE == 1
    # Additive classical decomposition
    bundle Ret = clc_decompose(y)

elif EXAMPLE == 2
    # Multiplicative decomposition with trend extrapolation: fills in the
    # missing values which the moving average leaves at both ends
    bundle opts = _(multiplicative=TRUE, extrapolate_trend=3)
    bundle Ret = clc_decompose(y, opts)

elif EXAMPLE == 3
    # STL decomposition with robust weights
    bundle opts = _(outer=1, inner=2, robust=TRUE)
    bundle Ret = stl_decompose(y, opts)
endif

# Retrieve the components as series
series trend = Ret.trend
series season = Ret.season
series remainder = Ret.remainder
list L = y trend season remainder

# Print the first and last 10 rows of the components
print L --head=10
print L --tail=10

# Strength of trend and seasonality
scalar FT = strength_trend(Ret)
scalar FS = strength_season(Ret)
printf "Strength of trend: %.3f, strength of seasonality: %.3f\n", FT, FS

# Plot the components
scalar err = plot_decompose(y, Ret)

# Components side by side, with an overall title
bundle plot_opts = _(layout="horizontal", title="Some decomposition")
err = plot_decompose(y, Ret, plot_opts)

# OPTIONAL: Three separate plots. To save them to file, pass "output", e.g.
# "decomposition.png", which produces decomposition_trend.png,
# decomposition_season.png and decomposition_remainder.png
#plot_opts = _(layout="separate", output="decomposition.png", width=400, height=400)
#err = plot_decompose(y, Ret, plot_opts)
