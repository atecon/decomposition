# Requires tsdecomp.inp (shared helpers); include that file first.

function series stl_index_ma (const series x, const int p)
    /* Centered simple p-term moving average via explicit lag/lead
    summation. Avoids movavg()'s undocumented, asymmetric edge/NA
    behavior for even p. */

    scalar half_lo = floor((p - 1) / 2)
    scalar half_hi = p - 1 - half_lo
    scalar jlo = -half_lo
    scalar jhi = half_hi

    series acc = 0
    loop j = jlo..jhi -q
        acc += x(j)
    endloop

    return acc / p
end function

function series stl_wloess (const series y, const series x,
                            const scalar q, const series prior_w)
    /* Weighted local-linear (d=1) loess: tricube kernel x external
    prior weight, closed-form weighted least squares (2 unknowns --
    intercept and slope) at each evaluation point. Needed because
    gretl's built-in loess() has no external-weight argument, but
    STL's outer-loop robustness weights (derived from the STL
    remainder) must be injected into Steps 2 and 6. Verified to match
    gretl's own loess() to floating-point precision when prior_w is
    all 1. Unlike loess(), it has no minimum number of observations.

    q is the span as a fraction of the number of points. As in the
    original STL implementation, q may exceed 1 (span larger than the
    number of points): the bandwidth is then widened by
    (q*n - n)/2 points on each side, so that all points keep a
    positive weight. */

    # keep missing values as NaN placeholders so that all matrices have
    # the same length as the sample (local to this function call)
    set skip_missing off

    scalar T = $nobs
    matrix xv = {x}
    matrix yv = {y}
    matrix wv = {prior_w}
    matrix okv = {ok(y)}

    matrix xok = selifr(xv, okv)
    matrix yok = selifr(yv, okv)
    matrix wok = selifr(wv, okv)
    scalar n = rows(xok)
    scalar n_local = ceil(min(q, 1) * n)
    # bandwidth widening for q > 1, in units of x
    scalar spacing = (n > 1) ? (max(xok) - min(xok)) / (n - 1) : 1
    scalar h_extra = (q > 1) ? (q * n - n) / 2 * spacing : 0

    series result = NA
    loop t = 1..T -q
        scalar xt = xv[t]
        if ok(xv[t])
            matrix d = abs(xok - xt)
            matrix ds = msortby(d ~ seq(1,n)', 1)
            scalar dmax = ds[min(n_local, n), 1] + h_extra
            if dmax <= 0
                dmax = 1
            endif
            matrix u = d ./ dmax
            matrix tw = (u .< 1) .* (1 - u.^3).^3
            matrix wt = tw .* wok
            scalar sw = sumc(wt)
            if sw > 0
                scalar xbar = sumc(wt .* xok) / sw
                matrix xc = xok .- xbar
                scalar sxx = sumc(wt .* xc.^2)
                scalar ybar = sumc(wt .* yok) / sw
                scalar b = (sxx > 1.0e-12) ? sumc(wt .* xc .* (yok .- ybar)) / sxx : 0
                result[t] = ybar + b * (xt - xbar)
            endif
        endif
    endloop

    return result
end function

function series stl_smooth (const series y, const series x,
                            const scalar q, const series rweights,
                            const bool use_rweights)
    /* Local-linear loess smoothing with span q (fraction of the number
    of valid points; may exceed 1).

    Uses gretl's built-in loess() (fast path) if no robustness weights
    are active and if the number of valid points is large enough:
    loess() fails for fewer than 16 points (and its span cannot exceed
    1). Otherwise the from-scratch stl_wloess() is used, which also
    handles robustness weights, since loess() cannot accept external
    weights. Both give the same results up to floating-point
    precision. */

    scalar min_loess_obs = 16

    if use_rweights || sum(ok(y)) < min_loess_obs
        return stl_wloess(y, x, q, rweights)
    else
        catch series result = loess(y, x, 1, min(q, 1))
        if $error
            funcerr "loess() failed; try a larger smoothing window or a longer series"
        endif
        return result
    endif
end function

function series stl_cycle_subseries_smooth (const series detrended,
                                            const int s_window,
                                            const int n_p,
                                            const series rweights,
                                            const bool use_rweights)
    /* STL Step 2: split the detrended series into n_p cycle-subseries
    and loess-smooth each one independently at its own observed
    positions (no pre/post extension: the smoother cannot evaluate
    beyond the current sample's date range without extensive dataset
    manipulation, so this is a minor simplification relative to the
    original Cleveland et al. algorithm). */

    series season_id = lincomb(seasonals(), seq(1, n_p))
    series result = NA

    loop j = 1..n_p -q
        smpl season_id == j --restrict
        scalar n_j = $nobs
        scalar q = s_window / n_j
        series xidx = obs
        series fit = stl_smooth(detrended, xidx, q, rweights, use_rweights)
        series result = fit
        smpl full
    endloop

    return result
end function

function series stl_lowpass (const series C, const int n_p, const int l_window)
    /* STL Step 3: low-pass filter of the temporary seasonal series --
    two n_p-length centered moving averages, then a length-3 centered
    moving average, then a final loess smoothing (which also re-fills
    the NAs left at the edges by the moving averages, since the
    smoother evaluates at every non-missing x regardless of y). */

    series ma1 = stl_index_ma(C, n_p)
    series ma2 = stl_index_ma(ma1, n_p)
    series ma3 = stl_index_ma(ma2, 3)

    series xidx = obs
    scalar n_ok = sum(ok(ma3))
    scalar q = l_window / n_ok
    series no_weights = 1
    series result = stl_smooth(ma3, xidx, q, no_weights, FALSE)

    return result
end function

function series stl_trend_smooth (const series deseasonalized, const int t_window,
                                 const series rweights, const bool use_rweights)
    /* STL Step 6: trend smoothing via loess. */

    series xidx = obs
    scalar n_ok = sum(ok(deseasonalized))
    scalar q = t_window / n_ok
    series result = stl_smooth(deseasonalized, xidx, q, rweights, use_rweights)

    return result
end function

function matrix stl_robustness_weights (const series remainder)
    /* Outer-loop bisquare robustness weights, per Cleveland et al.
    Section 2.4: h = 6*median(|R|); rho_v = B(|R_v|/h), B the
    bisquare function. median() skips missing values automatically
    (per gretl's funcref), so no manual NA filtering is needed. */

    scalar h = 6 * median(abs(remainder))
    if h < 1.0e-12
        # (numerically) perfect fit: nothing to down-weight
        series ones_rw = 1
        return {ones_rw}
    endif
    series u = abs(remainder) / h
    series rho = (u < 1) ? (1 - u^2)^2 : 0
    return {rho}
end function

function scalar stl_nextodd (const scalar x)
    /* Smallest odd integer >= x. */

    scalar n = ceil(x)
    return (n % 2 == 0) ? n + 1 : n
end function

function list stl_inner_loop (const series y,
                             const int n_p,
                             const int s_window,
                             const int t_window,
                             const int l_window,
                             const int n_i,
                             const series rweights,
                             const bool use_rweights,
                             const series trend0)
    /* Runs the STL inner loop (Steps 1-6) n_i times, starting from
    the trend 'trend0' (zero in the first pass; the previous trend in
    the outer robustness passes, as in Cleveland et al.), and returns
    the resulting {trend, season} list. */

    series trend = trend0
    series season = 0

    loop i = 1..n_i -q
        series detrended = y - trend
        series C = stl_cycle_subseries_smooth(detrended, s_window, n_p, rweights, use_rweights)
        series lowpass = stl_lowpass(C, n_p, l_window)
        series season = C - lowpass
        series deseasonalized = y - season
        series trend = stl_trend_smooth(deseasonalized, t_window, rweights, use_rweights)
    endloop

    list Lret = trend season
    return Lret
end function

function bundle stl_default_values (void)
    /* Set default values for stl_decompose()'s options bundle. */

    bundle self = defbundle()
    scalar self.s_window = 11
    scalar self.t_window = 0        # 0: set automatically
    scalar self.l_window = 0        # 0: set automatically
    scalar self.inner = 0           # 0: set automatically
    scalar self.outer = 0           # 0: set automatically
    scalar self.robust = FALSE
    scalar self.multiplicative = FALSE

    return self
end function

function bundle stl_decompose (const series y,
                               bundle opts[null])
    /* STL: Seasonal-Trend decomposition using Loess.
    https://otexts.com/fpp3/stl.html
    Cleveland, Cleveland, McRae & Terpenning (1990), "STL: A
    Seasonal-Trend Decomposition Procedure Based on Loess".

    The decomposition is additive. For a multiplicative decomposition
    pass log(y) and transform the components back, as done with
    Python's statsmodels.tsa.seasonal.STL().

    opts.s_window: span of the loess smoother applied to each
    cycle-subseries (seasonal window), default 11 as in R's STL().
    opts.t_window: span of the trend smoother; 0 (default) sets the
    smallest odd integer >= 1.5 * m / (1 - 1.5 / s_window).
    opts.l_window: span of the low-pass filter; 0 (default) sets the
    smallest odd integer >= m (m: seasonal period).
    opts.inner: number of inner loop iterations; 0 (default) sets 2.
    opts.outer: number of outer (robustness) iterations; 0 (default)
    sets 0 if not robust and 15 if robust.
    opts.robust: use robustness weights to reduce the influence of
    outliers (default FALSE). */

    bundle self = set_bundle_and_get_defaults(stl_default_values(), opts)

    scalar Torig = $nobs
    smpl y --contiguous
    scalar T = $nobs
    if T < Torig
        printf "Warning: %d missing observations were ignored.\n", (Torig - T)
    endif
    scalar n_p = $pd
    scalar self.frequency = n_p
    scalar self.nobs = T

    # At least three full cycles are required: the low-pass filter (Step 3)
    # applies moving averages of length n_p, n_p and 3, which leave only
    # T - 2*n_p valid points to be smoothed. Note that the seasonal smoother
    # (Step 2) works on cycle-subseries of only T/n_p points each, so many
    # more cycles are needed for a reliable estimate of a changing seasonal
    # pattern.
    check_seasonal_series(n_p, T, 3)
    errorif(self.s_window < 3, "opts.s_window must be at least 3.")

    if self.l_window == 0
        self.l_window = stl_nextodd(n_p)
    endif
    if self.t_window == 0
        self.t_window = stl_nextodd(1.5 * n_p / (1 - 1.5 / self.s_window))
    endif
    if self.inner == 0
        self.inner = 2
    endif
    if self.outer == 0
        self.outer = self.robust ? 15 : 0
    endif

    series rweights = 1
    series zero = 0
    list Linner = stl_inner_loop(y, n_p, self.s_window, self.t_window, \
                                 self.l_window, self.inner, rweights, FALSE, zero)
    series trend = Linner.trend
    series season = Linner.season

    loop o = 1..self.outer
        series remainder = y - trend - season
        matrix rw = stl_robustness_weights(remainder)
        series rweights = rw
        list Linner = stl_inner_loop(y, n_p, self.s_window, self.t_window, \
                                     self.l_window, self.inner, rweights, TRUE, trend)
        series trend = Linner.trend
        series season = Linner.season
    endloop

    series remainder = remainder_component(y, trend, season, FALSE)
    setinfo trend --description="Trend-cycle component (STL decomposition)" --graph-name="Trend-cycle"
    setinfo season --description="Seasonal component (STL decomposition)" --graph-name="Seasonal"
    setinfo remainder --description="Remainder component (STL decomposition)" --graph-name="Remainder"

    series self.trend = trend
    series self.season = season
    series self.remainder = remainder
    series self.y = y

    return self
end function
