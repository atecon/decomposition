set assert stop
set verbose off

include ../src/decomposition.inp --force
include ../src/stl.inp --force

# ---------------------------------------------------------------------
# Test 1: trend_component() with an EVEN seasonal period (m=4) must
# reproduce the 2x4-MA exactly, per the worked beer-production example
# in fpp3 (https://otexts.com/fpp3/classical-decomposition.html,
# Table 3.2). This guards against regressing to the old buggy
# movavg(y, 2*m, 1) (a plain, wrongly-wide moving average).
# ---------------------------------------------------------------------
nulldata 6
setobs 4 1992:1
series beer = {443, 410, 420, 532, 433, 421}
series trend = trend_component(beer)

assert(abs(trend[3] - 450.000) < 0.001)
assert(abs(trend[4] - 450.125) < 0.001)

printf "PASS: trend_component() matches fpp3 2x4-MA reference values\n"


# ---------------------------------------------------------------------
# Test 2: trend_component() with an ODD seasonal period (m=3) must
# reproduce a plain centered m-MA -- no doubling -- which is exactly
# hand-computable.
# ---------------------------------------------------------------------
nulldata 5
setobs 3 2020:1
series y = {2, 4, 6, 8, 10}
series trend = trend_component(y)

assert(abs(trend[2] - 4) < 1.0e-9)
assert(abs(trend[3] - 6) < 1.0e-9)
assert(abs(trend[4] - 8) < 1.0e-9)
assert(ok(trend[1]) == 0)
assert(ok(trend[5]) == 0)

printf "PASS: trend_component() matches plain centered 3-MA for odd frequency\n"


# ---------------------------------------------------------------------
# Test 3: full clc_decompose() on a noise-free synthetic series with an
# exact linear trend and an exact, already-centered seasonal pattern
# must recover both components exactly and leave a zero remainder
# wherever the trend is defined.
# ---------------------------------------------------------------------
nulldata 16
setobs 4 2020:1
series trend_true = 100 + 2*seq(1,16)'
series season_true = lincomb(seasonals(), {5, -5, 10, -10})
series y = trend_true + season_true

bundle Model = clc_decompose(y)

loop t = 3..14 -q
    assert(abs(Model.trend[t] - trend_true[t]) < 1.0e-6)
    assert(abs(Model.season[t] - season_true[t]) < 1.0e-6)
    assert(abs(Model.remainder[t]) < 1.0e-6)
endloop

printf "PASS: clc_decompose() exactly recovers a known trend+seasonal pattern\n"


# ---------------------------------------------------------------------
# Test 4: the seasonal component must sum to (approximately) zero over
# one full cycle -- the classical decomposition method requires the
# seasonal indices to be centered.
# ---------------------------------------------------------------------
matrix seasonal_cycle = aggregate(Model.season, lincomb(seasonals(), seq(1,$pd)), mean)[,3]
assert(abs(sumc(seasonal_cycle)) < 1.0e-6)

printf "PASS: seasonal component sums to zero over one cycle\n"


# ---------------------------------------------------------------------
# Test 5: extrapolate_trend_component() must fill in exactly the
# previously-NA edge positions of the beer-production trend (Test 1's
# series) and leave the already-valid interior values unchanged.
# ---------------------------------------------------------------------
nulldata 6
setobs 4 1992:1
series beer = {443, 410, 420, 532, 433, 421}
series trend = trend_component(beer)
series trend_ext = extrapolate_trend_component(trend, 2)

assert(ok(trend_ext[1]))
assert(ok(trend_ext[2]))
assert(abs(trend_ext[3] - trend[3]) < 1.0e-9)
assert(abs(trend_ext[4] - trend[4]) < 1.0e-9)
assert(ok(trend_ext[5]))
assert(ok(trend_ext[6]))

printf "PASS: extrapolate_trend_component() fills edge NAs and preserves interior values\n"


# ---------------------------------------------------------------------
# Test 6: on an exact linear trend (no noise), the OLS extrapolation
# must recover the true line exactly at the previously-NA edges, since
# OLS on perfectly linear points has zero residual.
# ---------------------------------------------------------------------
nulldata 16
setobs 4 2020:1
series trend_true = 100 + 2*seq(1,16)'
series season_true = lincomb(seasonals(), {5, -5, 10, -10})
series y = trend_true + season_true

bundle opts = defbundle("extrapolate_trend", 2)
bundle Model = clc_decompose(y, opts)

loop t = 1..16 -q
    assert(abs(Model.trend[t] - trend_true[t]) < 1.0e-6)
    assert(abs(Model.remainder[t]) < 1.0e-6)
endloop
assert(sum(ok(Model.trend)) == $nobs)
assert(sum(ok(Model.remainder)) == $nobs)

printf "PASS: clc_decompose() with extrapolate_trend exactly recovers edge trend values and leaves no NAs\n"


# ---------------------------------------------------------------------
# Test 7: extrapolate_trend defaults to 0 (off), so clc_decompose()
# called without it must reproduce Test 3's results unchanged --
# confirming no regression for existing callers.
# ---------------------------------------------------------------------
nulldata 16
setobs 4 2020:1
series trend_true = 100 + 2*seq(1,16)'
series season_true = lincomb(seasonals(), {5, -5, 10, -10})
series y = trend_true + season_true

bundle Model = clc_decompose(y)

loop t = 3..14 -q
    assert(abs(Model.trend[t] - trend_true[t]) < 1.0e-6)
endloop
assert(ok(Model.trend[1]) == 0)
assert(ok(Model.trend[2]) == 0)
assert(ok(Model.trend[15]) == 0)
assert(ok(Model.trend[16]) == 0)

printf "PASS: extrapolate_trend defaults to off, preserving prior edge-NA behavior\n"


# ---------------------------------------------------------------------
# Test 8: stl_decompose() on a noise-free series with a linear trend and
# an exact seasonal pattern must return the same bundle layout as
# clc_decompose(), reconstruct y exactly (y = trend + season +
# remainder), and recover trend and season closely in the interior.
# ---------------------------------------------------------------------
nulldata 80
setobs 4 2000:1
series trend_true = 100 + 2*seq(1,80)'
series season_true = lincomb(seasonals(), {5, -5, 10, -10})
series y = trend_true + season_true

bundle Model = stl_decompose(y)

assert(inbundle(Model, "trend") && inbundle(Model, "season") && \
       inbundle(Model, "remainder") && inbundle(Model, "y"))
assert(Model.frequency == 4)
assert(Model.nobs == 80)
assert(Model.multiplicative == 0)
assert(Model.s_window == 7)
assert(Model.t_window == 9)     # nextodd(1.5*4 / (1 - 1.5/7)) = nextodd(7.64)
assert(Model.l_window == 5)
assert(Model.inner == 2)
assert(Model.outer == 0)

series chk = y - Model.trend - Model.season - Model.remainder
assert(maxc({abs(chk)}) < 1.0e-9)

loop t = 20..60 -q
    assert(abs(Model.trend[t] - trend_true[t]) < 0.5)
    assert(abs(Model.season[t] - season_true[t]) < 0.5)
endloop

printf "PASS: stl_decompose() returns a consistent bundle and recovers trend and season\n"


# ---------------------------------------------------------------------
# Test 9: robust STL defaults (outer = 15) and reconstruction identity
# for noisy data with an outlier.
# ---------------------------------------------------------------------
set seed 42
series y_out = y + normal()
y_out[40] = y_out[40] + 200

bundle ModelR = stl_decompose(y_out, defbundle("s_window", 13, "robust", TRUE))

assert(ModelR.outer == 15)
assert(ModelR.inner == 2)
series chk = y_out - ModelR.trend - ModelR.season - ModelR.remainder
assert(maxc({abs(chk)}) < 1.0e-9)
# the outlier ends up in the remainder
assert(ModelR.remainder[40] > 150)

printf "PASS: robust stl_decompose() uses default iterations and isolates an outlier\n"


# ---------------------------------------------------------------------
# Test 10: set_bundle_and_get_defaults() lets 'opts' override defaults
# and works without 'opts'.
# ---------------------------------------------------------------------
bundle B = set_bundle_and_get_defaults(default_values(), defbundle("multiplicative", TRUE))
assert(B.multiplicative == 1)
assert(B.extrapolate_trend == 0)
bundle B2 = set_bundle_and_get_defaults(default_values())
assert(B2.multiplicative == 0)

printf "PASS: set_bundle_and_get_defaults() merges defaults and options\n"


# ---------------------------------------------------------------------
# Test 11: plot_filename() inserts the suffix before the file extension.
# ---------------------------------------------------------------------
assert(plot_filename("plots.png", "trend") == "plots_trend.png")
assert(plot_filename("a/b.c/out.pdf", "season") == "a/b.c/out_season.pdf")
assert(plot_filename("out", "remainder") == "out_remainder")
assert(plot_filename("a.b/out", "trend") == "a.b/out_trend")
assert(plot_filename("x.tar.gz", "trend") == "x.tar_trend.gz")
assert(plot_filename("/tmp/.hidden", "trend") == "/tmp/.hidden_trend")

printf "PASS: plot_filename() inserts the suffix before the file extension\n"


# ---------------------------------------------------------------------
# Test 12: plot_decompose() writes the expected files for each layout
# and rejects an invalid layout.
# ---------------------------------------------------------------------
nulldata 80
setobs 4 2000:1
series trend_true = 100 + 2*seq(1,80)'
series season_true = lincomb(seasonals(), {5, -5, 10, -10})
series y = trend_true + season_true + normal()
bundle Model = clc_decompose(y)

function scalar file_exists (const string fname)
    # readfile() raises an error for a missing file
    catch string content = readfile(fname)
    return $error == 0
end function

string base = sprintf("%s/plot_test", $dotdir)
string f_vertical = sprintf("%s_vertical.png", base)
string f_horizontal = sprintf("%s_horizontal.png", base)
string f_separate = sprintf("%s_separate.png", base)

assert(plot_decompose(y, Model, defbundle("output", f_vertical)) == 0)
assert(plot_decompose(y, Model, defbundle("output", f_horizontal, "layout", "horizontal")) == 0)
assert(plot_decompose(y, Model, defbundle("output", f_separate, "layout", "separate")) == 0)
assert(plot_decompose(y, Model, defbundle("layout", "diagonal")) == 1)

assert(file_exists(f_vertical))
assert(file_exists(f_horizontal))
assert(!file_exists(f_separate))
assert(file_exists(plot_filename(f_separate, "trend")))
assert(file_exists(plot_filename(f_separate, "season")))
assert(file_exists(plot_filename(f_separate, "remainder")))

printf "PASS: plot_decompose() supports vertical, horizontal and separate layouts\n"


printf "\nAll decomposition.inp tests passed.\n"
